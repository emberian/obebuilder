  "teeth": [
    {
      "id": "tier1-structural-anti-vacuity",
      "description": "Execute five built-in positive/negative structural scanner controls; no Lean execution.",
      "mutation": {
        "kind": "structural_probe"
      }
    },
    {
      "id": "tooth-judge-revert-bedrock",
      "description": "Verify that dropping revert@1 or home N bedrock in judge.json trips structural gate invariant check",
      "check_cmd": "python3 -c 'import json, sys; j = json.load(open(\"judge.json\")); ok = (\"revert@1\" in j[\"formats\"]) and any(f.startswith(\"home \") for f in j[\"floors\"]); sys.stderr.write(\"ASSERTION_FAILED: revert@1/home bedrock missing\\n\") if not ok else sys.stdout.write(\"ran 1 check: ok\\n\"); sys.exit(0 if ok else 1)'",
      "mutation": {
        "kind": "replace",
        "file": "judge.json",
        "search": "\"revert@1\",",
        "replace": ""
      },
      "expect_failure_substring": "ASSERTION_FAILED: revert@1/home bedrock missing",
      "timeout_ms": 5000
    }
  ]
